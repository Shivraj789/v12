<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Contact Us</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-black text-white">

  <!-- iOS-style background -->
  <div class="relative min-h-screen overflow-hidden">

    <div class="pointer-events-none absolute -left-32 -top-32
                h-96 w-96 rounded-full bg-red-600/10 blur-3xl">
    </div>

    <div class="pointer-events-none absolute -bottom-32 -right-32
                h-96 w-96 rounded-full bg-red-600/10 blur-3xl">
    </div>


    <!-- Main -->
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">

      <div
        class="w-full max-w-5xl overflow-hidden rounded-[32px]
               border border-white/10
               bg-white/[0.05]
               shadow-[0_25px_80px_rgba(0,0,0,0.55)]
               backdrop-blur-2xl">

        <div class="grid md:grid-cols-2">


          <!-- LEFT SIDE -->
          <div class="p-8 md:p-12">

            <!-- Contact label -->
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full
                     border border-red-500/20
                     bg-red-500/10
                     px-4 py-2
                     text-xs font-semibold uppercase
                     tracking-widest text-red-400">

              <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>

              Contact

            </div>


            <!-- Heading -->
            <h1 class="text-4xl font-black tracking-tight md:text-5xl">
              Let's Talk
            </h1>


            <p class="mt-5 max-w-md text-sm leading-7 text-gray-400">
              Have some big idea or brand to develop and need help?
              Reach out — we'd love to hear about your project and
              provide help.
            </p>


            <!-- Email -->
            <div class="mt-10">

              <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-500">
                Email
              </h2>

              <ul class="mt-4">

                <li>

                  <a
                    target="_blank"
                    href="https://veilmail.io/e/FkKh7o"
                    class="flex items-center gap-4 rounded-2xl
                           border border-white/10
                           bg-white/[0.04]
                           p-4
                           transition-all duration-300
                           hover:border-red-500/30
                           hover:bg-red-500/5">

                    <div
                      class="flex h-11 w-11 shrink-0 items-center justify-center
                             rounded-full bg-red-500/10 text-red-500">

                      ✉

                    </div>

                    <div>

                      <small class="block text-xs text-gray-500">
                        Mail
                      </small>

                      <strong class="text-sm text-white">
                        Contact us
                      </strong>

                    </div>

                  </a>

                </li>

              </ul>

            </div>


            <!-- Socials -->
            <div class="mt-10">

              <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-500">
                Socials
              </h2>

              <ul class="mt-4 flex space-x-3">

                <!-- Facebook -->
                <li>

                  <a
                    href="#"
                    class="flex h-11 w-11 items-center justify-center
                           rounded-full
                           border border-white/10
                           bg-white/5
                           text-sm font-bold text-gray-400
                           backdrop-blur-xl
                           transition-all duration-300
                           hover:-translate-y-1
                           hover:border-red-500/40
                           hover:bg-red-500/10
                           hover:text-red-400">

                    f

                  </a>

                </li>


                <!-- LinkedIn -->
                <li>

                  <a
                    href="#"
                    class="flex h-11 w-11 items-center justify-center
                           rounded-full
                           border border-white/10
                           bg-white/5
                           text-sm font-bold text-gray-400
                           backdrop-blur-xl
                           transition-all duration-300
                           hover:-translate-y-1
                           hover:border-red-500/40
                           hover:bg-red-500/10
                           hover:text-red-400">

                    in

                  </a>

                </li>


                <!-- Instagram -->
                <li>

                  <a
                    href="#"
                    class="flex h-11 w-11 items-center justify-center
                           rounded-full
                           border border-white/10
                           bg-white/5
                           text-sm font-bold text-gray-400
                           backdrop-blur-xl
                           transition-all duration-300
                           hover:-translate-y-1
                           hover:border-red-500/40
                           hover:bg-red-500/10
                           hover:text-red-400">

                    ◎

                  </a>

                </li>

              </ul>

            </div>


            <!-- MongoDB status -->
            <div class="mt-10 text-center md:text-left">

              <p class="text-xs text-gray-500">
                MongoDB server not set yet and social media link no working
              </p>

            </div>

          </div>


          <!-- RIGHT SIDE -->
          <div
            class="border-t border-white/10
                   bg-white/[0.025]
                   p-8
                   md:border-l md:border-t-0 md:p-12">

            <div class="mb-7">

              <p class="text-xs font-semibold uppercase
                        tracking-[0.25em] text-red-500">

                Get in touch

              </p>

              <h2 class="mt-2 text-2xl font-bold">
                Send us a message
              </h2>

            </div>


            <!-- Contact Form -->
            <form
              action="https://fabform.io/f/xxxxx"
              method="post"
              class="space-y-5">


              <!-- Name -->
              <div>

                <label class="mb-2 block text-sm text-gray-400">
                  Name
                </label>

                <input
                  type="text"
                  name="name"
                  placeholder="Your name"
                  required
                  class="w-full rounded-2xl
                         border border-white/10
                         bg-white/[0.05]
                         px-4 py-3.5
                         text-sm text-white
                         outline-none
                         placeholder:text-gray-600
                         backdrop-blur-xl
                         transition-all
                         focus:border-red-500/50
                         focus:bg-white/[0.08]
                         focus:ring-2
                         focus:ring-red-500/10">

              </div>


              <!-- Email -->
              <div>

                <label class="mb-2 block text-sm text-gray-400">
                  Email
                </label>

                <input
                  type="email"
                  name="email"
                  placeholder="you@example.com"
                  required
                  class="w-full rounded-2xl
                         border border-white/10
                         bg-white/[0.05]
                         px-4 py-3.5
                         text-sm text-white
                         outline-none
                         placeholder:text-gray-600
                         backdrop-blur-xl
                         transition-all
                         focus:border-red-500/50
                         focus:bg-white/[0.08]
                         focus:ring-2
                         focus:ring-red-500/10">

              </div>


              <!-- Subject -->
              <div>

                <label class="mb-2 block text-sm text-gray-400">
                  Subject
                </label>

                <input
                  type="text"
                  name="subject"
                  placeholder="How can we help?"
                  required
                  class="w-full rounded-2xl
                         border border-white/10
                         bg-white/[0.05]
                         px-4 py-3.5
                         text-sm text-white
                         outline-none
                         placeholder:text-gray-600
                         backdrop-blur-xl
                         transition-all
                         focus:border-red-500/50
                         focus:bg-white/[0.08]
                         focus:ring-2
                         focus:ring-red-500/10">

              </div>


              <!-- Message -->
              <div>

                <label class="mb-2 block text-sm text-gray-400">
                  Message
                </label>

                <textarea
                  name="message"
                  rows="5"
                  placeholder="Tell us about your project..."
                  required
                  class="w-full resize-none rounded-2xl
                         border border-white/10
                         bg-white/[0.05]
                         px-4 py-3.5
                         text-sm text-white
                         outline-none
                         placeholder:text-gray-600
                         backdrop-blur-xl
                         transition-all
                         focus:border-red-500/50
                         focus:bg-white/[0.08]
                         focus:ring-2
                         focus:ring-red-500/10"></textarea>

              </div>


              <!-- Submit -->
              <button
                type="submit"
                class="w-full rounded-2xl
                       bg-red-600
                       px-6 py-4
                       text-sm font-bold text-white
                       shadow-lg shadow-red-600/20
                       transition-all duration-300
                       hover:-translate-y-0.5
                       hover:bg-red-500
                       hover:shadow-red-600/30
                       active:translate-y-0">

                Send Message →

              </button>


              <p class="text-center text-xs text-gray-600">
                We'll get back to you as soon as possible.
              </p>

            </form>

          </div>

        </div>

      </div>

    </div>

  </div>

</body>
</html>