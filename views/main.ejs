<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>FatShe™ Business Directory</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-white">

  
  <!-- Navbar -->
  <nav class="bg-black border-b border-gray-800">
    <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">

      <!-- Logo -->
<img src="/sheetal_logo.png" alt="Logo" class="w-20 h-10 -ml-21">
      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-400 rounded-lg md:hidden hover:bg-gray-800"
      >
        <span class="sr-only">Open main menu</span>

        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          />
        </svg>
      </button>

      <!-- Navigation Links -->
      <div class="hidden w-full md:block md:w-auto">
        <ul class="font-medium flex flex-col p-4 md:p-0 mt-4
                   md:flex-row md:space-x-8 md:mt-0">

          

          <li>
            <a href="#" class="block py-2 px-3 text-white hover:text-red-600 md:p-0">
              About
            </a>
          </li>

          <li>
            <a href="/service" class="block py-2 px-3 text-white hover:text-red-600 md:p-0">
              Services
            </a>
          </li>

          <li>
            <a href="#" class="block py-2 px-3 text-white hover:text-red-600 md:p-0">
              Pricing
            </a>
          </li>

          <li>
            <a href="/contact" class="block py-2 px-3 text-white hover:text-red-600 md:p-0">
              Contact
            </a>
          </li>

        </ul>
      </div>
    </div>
  </nav>


  <!-- Hero Section -->
  <main>

    <section class="mx-auto max-w-7xl px-6 py-16">

      <div class="grid items-center gap-12 md:grid-cols-2">

        <!-- Text -->
        <div>

          <p class="mb-4 font-semibold uppercase tracking-[0.25em] text-[#FF0000]">
            Business Directory
          </p>

          <h1 class="text-4xl font-bold leading-tight md:text-6xl">
            FatShe<span class="text-[#FF0000]">™</span>
            <br>
            Business Directory
          </h1>

          <p class="mt-6 text-lg leading-8 text-gray-300">
            Welcome to FatShe™, an online business listing directory
            designed to help businesses build their online presence
            and reach more customers.
          </p>

          <p class="mt-4 leading-8 text-gray-400">
            We offer internet marketing and search engine optimization
            services for businesses. We undertake different types of
            digital marketing based on the products or services that
            need to be promoted.
          </p>

          <p class="mt-4 leading-8 text-gray-400">
            Our expertise in social media marketing helps businesses
            promote their brands, connect with their audience and
            improve their online visibility.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">

            <a
              href="/services"
              class="rounded-lg bg-[#FF0000] px-7 py-3 font-semibold text-white transition hover:bg-[#CC0000]"
            >
              Explore Services
            </a>

            <a
              href="#about"
              class="rounded-lg border border-[#990000] px-7 py-3 font-semibold text-white transition hover:border-[#FF0000] hover:text-[#FF0000]"
            >
              Learn More
            </a>

          </div>

        </div>


        <!-- Image -->
        <div class="flex justify-center">

          <div class="overflow-hidden rounded-2xl border border-[#990000] bg-[#990000]/10 p-2 shadow-2xl">

            <img
              src="https://sheetal.net/images/business-directory.jpg"
              alt="FatShe Business Directory"
              class="w-full max-w-xl rounded-xl object-cover"
            >

          </div>

        </div>

      </div>

    </section>


    <!-- About -->
    <section
      id="about"
      class="border-y border-[#990000] bg-[#990000]/10 px-6 py-16"
    >

      <div class="mx-auto max-w-6xl text-center">

        <p class="mb-3 font-semibold uppercase tracking-[0.2em] text-[#FF0000]">
          About FatShe™
        </p>

        <h2 class="text-3xl font-bold md:text-4xl">
          Helping Businesses Grow Online
        </h2>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-400">
          FatShe™ provides business listing, internet marketing,
          search engine optimization and social media marketing
          services to help businesses improve their online visibility
          and promote their products and services.
        </p>

      </div>

    </section>


    <!-- Services -->
    <section class="mx-auto max-w-7xl px-6 py-16">

      <div class="mb-12 text-center">

        <p class="font-semibold uppercase tracking-[0.2em] text-[#FF0000]">
          What We Do
        </p>

        <h2 class="mt-3 text-3xl font-bold md:text-4xl">
          Our Services
        </h2>

      </div>


      <div class="grid gap-6 md:grid-cols-3">

        <!-- Business Directory -->
        <div class="rounded-2xl border border-[#990000] bg-[#990000]/10 p-7 transition hover:-translate-y-1 hover:border-[#FF0000]">

          <h3 class="text-xl font-bold">
            Business Directory
          </h3>

          <p class="mt-4 leading-7 text-gray-400">
            List and promote your business through our online
            business directory and improve your digital presence.
          </p>

        </div>


        <!-- SEO -->
        <div class="rounded-2xl border border-[#990000] bg-[#990000]/10 p-7 transition hover:-translate-y-1 hover:border-[#FF0000]">

          <h3 class="text-xl font-bold">
            Search Engine Optimization
          </h3>

          <p class="mt-4 leading-7 text-gray-400">
            Improve your website visibility through search engine
            optimization and reach customers searching for your
            products and services.
          </p>

        </div>


        <!-- Social Media -->
        <div class="rounded-2xl border border-[#990000] bg-[#990000]/10 p-7 transition hover:-translate-y-1 hover:border-[#FF0000]">

          <h3 class="text-xl font-bold">
            Social Media Marketing
          </h3>

          <p class="mt-4 leading-7 text-gray-400">
            Promote your brand through social media marketing and
            connect your business with the right audience.
          </p>

        </div>

      </div>

    </section>


   <div class="bg-black">

  <!-- Advertisement Section -->
  <div class="flex items-center justify-between bg-[#BC0202] px-24 py-7">

    <h1 class="text-4xl font-bold text-white">
      To Place your Advertisement
    </h1>

    <div class="border-2 border-black px-10 py-6">
      <h2 class="text-2xl font-bold text-black">
        Call : 8121951331
      </h2>
    </div>

  </div>


  <!-- Footer Section -->
  <div class="flex justify-between px-24 py-8 text-white">

    <!-- Contact Us -->
    <div>
      <h2 class="mb-4 text-xl font-bold">
        CONTACT US
      </h2>

      <p class="mb-2 text-base">
        » <span class="text-white">Address :</span>
        <span class="text-gray-500">
          FatShe™ Packers Movers
        </span>
      </p>

      <p class="mb-2 text-base text-gray-500">
        IFEM, Plot NO 2, 2<sup>nd</sup> Floor
      </p>

      <p class="mb-4 text-base text-gray-500">
        Kapil Vihar, Delhi - 110034
      </p>

      <p class="mb-2 text-base">
        » <span class="text-white">Mobile No :</span>
        <span class="text-gray-500">8121951331</span>
      </p>

      <p class="text-base">
        » <span class="text-white">E-mail :</span>
        <span class="text-gray-500">contact@sheetal.net</span>
      </p>
    </div>


    <!-- Office Timings -->
    <div class="mr-24">

      <h2 class="mb-4 text-xl font-bold">
        OFFICE TIMINGS
      </h2>

      <p class="mb-2 text-base">
        Monday To Saturday
        <span class="text-gray-500">
          10:00 am To 8:00 pm
        </span>
      </p>

      <p class="text-base">
        Sunday
        <span class="text-gray-500">
          Closed
        </span>
      </p>

    </div>

  </div>

</div>

</body>
</html>